generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Receipt {
  id                      String        @id @default(cuid())
  vendor                  String
  receiptDate             DateTime?
  description             String?
  subtotal                Decimal       @db.Decimal(12, 2)
  taxAmount               Decimal       @db.Decimal(12, 2)
  total                   Decimal       @db.Decimal(12, 2)
  taxType                 String?
  gstHstNumber            String?
  commercialUsePercentage Decimal?      @db.Decimal(5, 2)
  mealExceptionProposal  String?
  category                String?
  receiptAvailable        Boolean       @default(true)
  status                  ReceiptStatus @default(PENDING)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  agentRuns               AgentRun[]
  approvals               Approval[]
  auditEvents             AuditEvent[]
  expense                 Expense?

  @@index([receiptDate])
  @@index([status])
  @@index([vendor])
}

model Expense {
  id                      String                      @id @default(cuid())
  receiptId               String                      @unique
  category                String?
  gifiCode                String?
  commercialUsePercentage Decimal?                    @db.Decimal(5, 2)
  mealException           String?
  grossTax                Decimal?                    @db.Decimal(12, 2)
  eligibilityPercentage   Decimal?                    @db.Decimal(5, 2)
  eligibleItc             Decimal?                    @db.Decimal(12, 2)
  itcStatus               ITCStatus?
  classificationStatus    ExpenseClassificationStatus @default(PENDING)
  confidence              Decimal?                    @db.Decimal(5, 4)
  reason                  String?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  receipt                 Receipt                     @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([gifiCode])
  @@index([classificationStatus])
}

model GifiCode {
  code                   String   @id
  description            String
  category               String
  parentCategory         String?
  applicableExpenseTypes Json?
  confidence             Decimal? @db.Decimal(5, 4)
  source                 String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model ComplianceRule {
  id            String            @id @default(cuid())
  ruleKey       String            @unique
  version       String
  description   String
  configuration Json?
  sourceId      String?
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  source        ComplianceSource? @relation(fields: [sourceId], references: [id])

  @@index([version])
  @@index([active])
}

model ComplianceSource {
  id          String              @id @default(cuid())
  authority   ComplianceAuthority
  title       String
  url         String
  retrievedAt DateTime?
  ruleVersion String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  rules       ComplianceRule[]

  @@index([authority])
  @@index([ruleVersion])
}

model AgentRun {
  id          String         @id @default(cuid())
  receiptId   String?
  requestId   String?
  model       String?
  provider    String?
  status      AgentRunStatus @default(RUNNING)
  currentStep String?
  currentTool String?
  iteration   Int            @default(0)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  error       String?
  receipt     Receipt?       @relation(fields: [receiptId], references: [id])
  approvals   Approval[]
  auditEvents AuditEvent[]
  toolCalls   ToolCall[]
  @@index([receiptId])
  @@index([requestId])
  @@index([status])
  @@index([startedAt])
}

model ToolCall {
  id          String         @id @default(cuid())
  agentRunId  String
  toolName    String
  input       Json
  output      Json?
  status      ToolCallStatus @default(RUNNING)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  latencyMs   Int?
  error       String?
  agentRun    AgentRun       @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@index([toolName])
  @@index([status])
}

model AuditEvent {
  id          String      @id @default(cuid())
  timestamp   DateTime    @default(now())
  actor       String
  receiptId   String?
  agentRunId  String?
  action      String
  inputHash   String?
  resultHash  String?
  ruleVersion String?
  model       String?
  status      AuditStatus
  metadata    Json?
  agentRun    AgentRun?   @relation(fields: [agentRunId], references: [id])
  receipt     Receipt?    @relation(fields: [receiptId], references: [id])

  @@index([receiptId])
  @@index([agentRunId])
  @@index([timestamp])
  @@index([action])
}

model Approval {
  id               String         @id @default(cuid())
  receiptId        String
  agentRunId       String?
  status           ApprovalStatus @default(PENDING)
  proposedCategory String?
  proposedGifiCode String?
  proposedItc      Decimal?       @db.Decimal(12, 2)
  proposedMealException String?
  reason           String?
  reviewer         String?
  decision         String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  agentRun         AgentRun?      @relation(fields: [agentRunId], references: [id])
  receipt          Receipt        @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([agentRunId])
  @@index([status])
}

enum ReceiptStatus {
  PENDING
  PROCESSING
  REVIEW_REQUIRED
  COMPLETED
  ERROR
}

enum ExpenseClassificationStatus {
  PENDING
  CLASSIFIED
  REVIEW_REQUIRED
  REJECTED
}

enum ITCStatus {
  ELIGIBLE
  PARTIAL
  INELIGIBLE
  REVIEW
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ToolCallStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum AuditStatus {
  SUCCESS
  FAILURE
  REVIEW_REQUIRED
}

enum ComplianceAuthority {
  CRA
}
